<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>방구석 프로 낚시터</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { -webkit-tap-highlight-color: transparent; user-select: none; box-sizing: border-box; }
        body { background-color: #090d16; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; touch-action: manipulation; }
        .water-gradient {
            background: linear-gradient(180deg, #0b1329 0%, #0d2744 35%, #104470 70%, #1e6091 100%);
        }
        @keyframes bobbing {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(7px) rotate(2deg); }
        }
        .bobber-float { animation: bobbing 2.6s infinite ease-in-out; }
        @keyframes biteShake {
            0% { transform: translate(0, 0); }
            25% { transform: translate(-4px, 12px); }
            50% { transform: translate(4px, 15px); }
            75% { transform: translate(-2px, 8px); }
            100% { transform: translate(0, 0); }
        }
        .bobber-bite { animation: biteShake 0.35s infinite ease-in-out; }
        .modal-backdrop { background-color: rgba(0, 0, 0, 0.82); backdrop-filter: blur(5px); }
        
        /* 미포획 물고기 실루엣 */
        .fish-silhouette {
            filter: brightness(0) opacity(0.22);
        }

        /* 15강/특수 낚싯대 RGB 애니메이션 */
        @keyframes rainbowRgb {
            0%   { border-color: #ff2a5f; box-shadow: 0 0 14px rgba(255, 42, 95, 0.7); }
            25%  { border-color: #ffaa00; box-shadow: 0 0 14px rgba(255, 170, 0, 0.7); }
            50%  { border-color: #00ff88; box-shadow: 0 0 14px rgba(0, 255, 136, 0.7); }
            75%  { border-color: #00bfff; box-shadow: 0 0 14px rgba(0, 191, 255, 0.7); }
            100% { border-color: #d800ff; box-shadow: 0 0 14px rgba(216, 0, 255, 0.7); }
        }
        .rod-rgb-glow {
            animation: rainbowRgb 2.2s linear infinite;
        }
        .btn-reel-touch {
            touch-action: none;
            -webkit-user-select: none;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col justify-between">

    <!-- 상단 대시보드 -->
    <header class="bg-slate-900/95 border-b border-slate-800 px-3 py-2 flex items-center justify-between z-20">
        <div class="flex items-center space-x-2">
            <button onclick="openNicknameModal()" class="flex items-center space-x-1 bg-slate-800 px-2 py-1 rounded-lg border border-slate-700 active:scale-95 transition">
                <i class="fa-solid fa-user text-sky-400 text-[10px]"></i>
                <span id="displayNickname" class="text-xs font-bold text-slate-200 truncate max-w-[70px]">강태공</span>
            </button>
            <div class="flex items-center space-x-1 bg-amber-950/40 border border-amber-500/30 px-2 py-1 rounded-lg text-xs font-semibold text-amber-300">
                <span>💰</span><span id="goldText">0</span>
            </div>
            <div class="flex items-center space-x-1 bg-cyan-950/40 border border-cyan-500/30 px-2 py-1 rounded-lg text-xs font-semibold text-cyan-300">
                <span>💎</span><span id="stoneText">0</span>
            </div>
        </div>

        <div class="flex items-center space-x-1.5">
            <!-- 착용 중인 낚싯대 배지 -->
            <div id="rodBadgeContainer" class="px-2 py-0.5 rounded-lg border-2 text-[10px] font-black tracking-wide">
                <span id="rodBadgeName">낚싯대</span>
            </div>
            <!-- 음소거 토글 -->
            <button id="muteBtn" onclick="toggleMute()" class="w-7 h-7 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300 active:scale-95 transition">
                <i id="muteIcon" class="fa-solid fa-volume-high text-xs"></i>
            </button>
        </div>
    </header>

    <!-- 중앙 낚시 화면 -->
    <main class="relative flex-1 water-gradient overflow-hidden flex items-center justify-center">
        <!-- 물결 파티클 -->
        <div class="absolute inset-0 opacity-20 pointer-events-none">
            <div class="absolute w-80 h-80 rounded-full border border-sky-300 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 animate-ping" style="animation-duration: 4.5s;"></div>
            <div class="absolute w-52 h-52 rounded-full border border-sky-200 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 animate-ping" style="animation-duration: 3s; animation-delay: 1s;"></div>
        </div>

        <!-- 낚싯줄 -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
            <line x1="50%" y1="0" x2="50%" y2="50%" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" stroke-dasharray="3,3" />
        </svg>

        <!-- 찌 오브젝트 -->
        <div id="bobberContainer" class="relative z-10 flex flex-col items-center">
            <div id="hitBubble" class="hidden absolute -top-12 bg-red-600 text-white font-black text-xs px-3 py-1 rounded-full shadow-lg border-2 border-white animate-bounce">
                💥 챔질(HIT)!
            </div>
            <div id="bobber" class="w-7 h-14 relative bobber-float transition-all duration-300">
                <div class="w-1.5 h-5 bg-red-500 mx-auto rounded-t"></div>
                <div class="w-6 h-6 bg-amber-400 rounded-full mx-auto border-2 border-slate-900 -mt-1 shadow-md"></div>
                <div class="w-1 h-4 bg-slate-800 mx-auto"></div>
            </div>
        </div>

        <!-- 모바일 최적화 릴링 미니게임 UI -->
        <div id="reelingUI" class="hidden absolute inset-x-4 top-12 bottom-16 bg-slate-950/90 rounded-2xl border border-sky-500/40 p-4 flex flex-col justify-between z-30 shadow-2xl backdrop-blur-md">
            <!-- 상단 난이도 인디케이터 -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <div>
                    <span id="fightFishTierBadge" class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-sky-900 text-sky-300">일반 어종</span>
                    <span id="fightFishDifficulty" class="text-xs text-amber-400 font-bold ml-1.5">⭐ 난이도: 1.5</span>
                </div>
                <span class="text-[11px] text-slate-400">초록 영역을 유지하세요</span>
            </div>

            <!-- 게이지 영역 (모바일 조작성 향상을 위해 너비 확장) -->
            <div class="flex items-center justify-center space-x-6 py-2">
                <div class="relative w-20 h-56 bg-slate-900 border-2 border-slate-700 rounded-xl overflow-hidden shadow-inner">
                    <!-- 물고기 스위트스팟 존 -->
                    <div id="fishSweetZone" class="absolute w-full bg-emerald-500/50 border-y-2 border-emerald-400 transition-all duration-150" style="height: 38%; bottom: 30%;"></div>
                    <!-- 유저 찌 인디케이터 -->
                    <div id="tensionIndicator" class="absolute w-full h-7 bg-amber-400 border-2 border-white rounded shadow-md transition-all duration-75" style="bottom: 10%;"></div>
                </div>

                <!-- 포획 진행률 바 -->
                <div class="flex flex-col items-center">
                    <span class="text-[11px] font-bold text-slate-300 mb-1">포획률</span>
                    <div class="w-5 h-56 bg-slate-800 rounded-full overflow-hidden border border-slate-700 p-0.5">
                        <div id="captureProgress" class="w-full bg-gradient-to-t from-sky-500 to-emerald-400 rounded-full transition-all duration-75" style="height: 45%;"></div>
                    </div>
                    <span id="capturePercentText" class="text-xs font-mono font-bold text-emerald-400 mt-1">45%</span>
                </div>
            </div>

            <!-- 릴 감기 터치 버튼 -->
            <div class="px-1">
                <button id="reelBtn" class="btn-reel-touch w-full py-4 bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-black text-lg rounded-xl shadow-lg active:scale-95 border-t border-amber-300 transition">
                    🎣 릴 감기 (누르고 있기)
                </button>
            </div>
        </div>

        <!-- 하단 안내 토스트 -->
        <div id="statusToast" class="absolute bottom-4 bg-slate-900/90 border border-slate-700 px-4 py-1.5 rounded-full text-xs font-medium text-slate-300 shadow text-center max-w-[90%] truncate">
            [찌 던지기]를 눌러 낚시를 시작하세요.
        </div>
    </main>

    <!-- 하단 메뉴 네비게이션 -->
    <footer class="bg-slate-900 border-t border-slate-800 p-3 flex flex-col space-y-2 z-20">
        <button id="castActionBtn" onclick="handleMainAction()" class="w-full py-3 bg-gradient-to-r from-sky-500 to-blue-600 text-white font-black text-base rounded-xl shadow-lg active:scale-[0.98] transition border-t border-sky-300 flex items-center justify-center space-x-2">
            <i class="fa-solid fa-water"></i>
            <span id="actionBtnText">찌 던지기</span>
        </button>

        <div class="grid grid-cols-2 gap-2">
            <button onclick="openUpgradeModal()" class="py-2.5 bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold rounded-lg flex items-center justify-center space-x-1.5 active:scale-95 transition">
                <span>🔨</span>
                <span>낚싯대 공방 & 특수대</span>
            </button>
            <button onclick="openBookModal()" class="py-2.5 bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold rounded-lg flex items-center justify-center space-x-1.5 active:scale-95 transition">
                <span>📖</span>
                <span>물고기 도감 (100종)</span>
                <span id="bookNewDot" class="hidden w-2 h-2 rounded-full bg-red-500"></span>
            </button>
        </div>
    </footer>

    <!-- ================= MODALS ================= -->

    <!-- 1. 닉네임 설정 모달 -->
    <div id="nicknameModal" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-700 w-full max-w-xs rounded-2xl p-5 shadow-2xl">
            <h3 class="text-base font-black text-white text-center mb-1">🎣 닉네임 설정</h3>
            <p class="text-xs text-slate-400 text-center mb-3">개인 저장소에 저장되어 다른 유저와 겹치지 않습니다.</p>
            <input id="nicknameInput" type="text" maxlength="8" placeholder="최대 8글자" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-sky-500 text-center font-bold mb-4">
            <button onclick="saveNickname()" class="w-full py-2.5 bg-sky-500 text-white font-bold rounded-xl active:scale-95 transition text-sm">확인</button>
        </div>
    </div>

    <!-- 2. 낚싯대 공방 모달 (15강 일반대 + 도감 연동 특수 낚싯대) -->
    <div id="upgradeModal" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-3">
        <div class="bg-slate-900 border border-slate-700 w-full max-w-sm h-[82vh] rounded-2xl p-4 shadow-2xl flex flex-col">
            <div class="flex justify-between items-center pb-2 border-b border-slate-800">
                <h3 class="text-base font-black text-white">🔨 낚싯대 장비실</h3>
                <button onclick="closeModal('upgradeModal')" class="text-slate-400 hover:text-white p-1 text-sm"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- 탭 전환 -->
            <div class="grid grid-cols-2 gap-2 my-2.5">
                <button id="tabNormalRodBtn" onclick="switchRodTab('normal')" class="py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400 transition">
                    일반 15강화
                </button>
                <button id="tabSpecialRodBtn" onclick="switchRodTab('special')" class="py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 transition">
                    도감 특수 낚싯대
                </button>
            </div>

            <!-- 내용 영역 -->
            <div class="flex-1 overflow-y-auto space-y-3 pr-1 text-xs">
                <!-- 일반 15강 탭 -->
                <div id="normalRodPanel" class="space-y-3">
                    <div id="rodPreviewCard" class="bg-slate-950 border-2 rounded-xl p-4 text-center transition-all">
                        <div class="text-3xl mb-1">🎣</div>
                        <div id="rodPreviewName" class="text-base font-extrabold text-white">기본 낚싯대 (+0)</div>
                        <div id="rodPreviewStats" class="text-xs text-slate-400 mt-1">스위트스팟: +0% | 희귀 어종 보너스: +0%</div>
                    </div>

                    <div class="bg-slate-800/60 rounded-xl p-3 text-xs space-y-2 border border-slate-700/60">
                        <div class="flex justify-between">
                            <span class="text-slate-400">다음 단계</span>
                            <span id="nextRodName" class="font-bold text-sky-400">+1 낚싯대</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">성공 확률</span>
                            <span id="upgradeChance" class="font-bold text-amber-400">100%</span>
                        </div>
                        <div class="flex justify-between border-t border-slate-700 pt-2">
                            <span class="text-slate-400">필요 재화</span>
                            <span class="font-bold text-slate-200">
                                💰 <span id="reqGold">100</span>G / 💎 <span id="reqStone">1</span>개
                            </span>
                        </div>
                    </div>

                    <button id="upgradeActionBtn" onclick="tryUpgradeRod()" class="w-full py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-black rounded-xl active:scale-95 transition shadow-lg text-sm">
                        강화 시도
                    </button>
                </div>

                <!-- 도감 연동 특수 낚싯대 탭 -->
                <div id="specialRodPanel" class="hidden space-y-2.5">
                    <p class="text-[11px] text-slate-400">도감의 특정 어종들을 수집하면 자동으로 해금됩니다.</p>
                    <div id="specialRodList" class="space-y-2">
                        <!-- 동적으로 렌더링 -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. 물고기 도감 모달 -->
    <div id="bookModal" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-3">
        <div class="bg-slate-900 border border-slate-700 w-full max-w-md h-[85vh] rounded-2xl p-4 shadow-2xl flex flex-col">
            <div class="flex justify-between items-center pb-2 border-b border-slate-800">
                <div>
                    <h3 class="text-base font-black text-white">📖 물고기 생태 도감</h3>
                    <div class="text-[11px] text-slate-400">발견: <span id="bookCaughtCount" class="text-sky-400 font-bold">0</span> / 100종</div>
                </div>
                <button onclick="closeModal('bookModal')" class="text-slate-400 hover:text-white p-1 text-sm"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="grid grid-cols-2 gap-2 my-2.5">
                <button id="tabDomesticBtn" onclick="switchBookTab('domestic')" class="py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400 transition">
                    🇰🇷 국내 어종 (50)
                </button>
                <button id="tabOverseasBtn" onclick="switchBookTab('overseas')" class="py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 transition">
                    🌎 해외 어종 (50)
                </button>
            </div>

            <div id="bookList" class="flex-1 overflow-y-auto space-y-2 pr-1 text-xs">
                <!-- 도감 동적 생성 -->
            </div>
        </div>
    </div>

    <!-- 4. 포획 성공 결과 모달 -->
    <div id="resultModal" class="hidden fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-700 w-full max-w-xs rounded-2xl p-5 shadow-2xl text-center">
            <span id="resultGradeBadge" class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-sky-900 text-sky-300 border border-sky-600">일반</span>
            <div id="resultFishIcon" class="text-5xl my-2">🐟</div>
            <h4 id="resultFishName" class="text-base font-black text-white">붕어</h4>
            <div id="resultFishLength" class="text-xs text-amber-400 font-bold mb-3">18.4cm</div>

            <div class="bg-slate-950 rounded-xl p-3 text-xs space-y-1.5 border border-slate-800 text-left mb-3">
                <div class="flex justify-between">
                    <span class="text-slate-400">획득 골드</span>
                    <span id="resultGainGold" class="font-bold text-amber-300">+25G</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">획득 경험치</span>
                    <span id="resultGainExp" class="font-bold text-sky-300">+10 EXP</span>
                </div>
            </div>

            <button onclick="copyKakaoResultText()" class="w-full py-2.5 mb-2 bg-yellow-400 text-slate-950 font-black rounded-xl text-xs flex items-center justify-center space-x-1 active:scale-95 transition">
                <i class="fa-solid fa-comment"></i>
                <span>카카오톡 공유 문구 복사</span>
            </button>
            <button onclick="closeModal('resultModal')" class="w-full py-2 bg-slate-800 text-slate-300 font-bold rounded-xl text-xs active:scale-95 transition">확인</button>
        </div>
    </div>

    <!-- ================= JAVASCRIPT LOGIC ================= -->
    <script>
        // 1. 사운드 시스템 (Web Audio API)
        let audioCtx = null;
        let isMuted = localStorage.getItem('fishing_muted_v3') === 'true';

        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        function playTone(freq, type, duration, vol = 0.08) {
            if (isMuted) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(vol, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e) {}
        }

        function soundSplash() { playTone(120, 'sine', 0.4, 0.2); }
        function soundHit() { playTone(880, 'triangle', 0.15, 0.3); setTimeout(() => playTone(1174, 'triangle', 0.2, 0.3), 100); }
        function soundSuccess() { [523, 659, 783, 1046].forEach((f, i) => setTimeout(() => playTone(f, 'sine', 0.25, 0.15), i * 90)); }
        function soundFail() { playTone(150, 'sawtooth', 0.3, 0.2); }
        function soundClick() { playTone(440, 'square', 0.04, 0.05); }

        function toggleMute() {
            isMuted = !isMuted;
            localStorage.setItem('fishing_muted_v3', isMuted);
            updateMuteUI();
        }

        function updateMuteUI() {
            const icon = document.getElementById('muteIcon');
            icon.className = isMuted ? 'fa-solid fa-volume-xmark text-red-400 text-xs' : 'fa-solid fa-volume-high text-slate-300 text-xs';
        }

        // 2. 15강화 일반 낚싯대 스펙
        const ROD_TIERS = [
            { level: 0,  name: '견습 대나무대',  zone: 38, bonus: 0,  costG: 80,    costS: 1,  rate: 100, border: 'border-slate-500 text-slate-400' },
            { level: 1,  name: '보강 대나무대',  zone: 40, bonus: 2,  costG: 150,   costS: 1,  rate: 95,  border: 'border-slate-400 text-slate-300' },
            { level: 2,  name: '일반 글라스대',  zone: 42, bonus: 4,  costG: 250,   costS: 1,  rate: 90,  border: 'border-emerald-600 text-emerald-400' },
            { level: 3,  name: '강화 글라스대',  zone: 44, bonus: 6,  costG: 450,   costS: 2,  rate: 85,  border: 'border-emerald-500 text-emerald-300' },
            { level: 4,  name: '스탠다드 카본',  zone: 46, bonus: 8,  costG: 750,   costS: 2,  rate: 80,  border: 'border-sky-500 text-sky-400' },
            { level: 5,  name: '하이 카본 프로', zone: 48, bonus: 10, costG: 1200,  costS: 3,  rate: 75,  border: 'border-sky-400 text-sky-300' },
            { level: 6,  name: '경량 티타늄대',  zone: 50, bonus: 13, costG: 1800,  costS: 3,  rate: 70,  border: 'border-indigo-500 text-indigo-400' },
            { level: 7,  name: '초경질 티타늄',  zone: 52, bonus: 16, costG: 2700,  costS: 4,  rate: 65,  border: 'border-purple-500 text-purple-400' },
            { level: 8,  name: '보론 나노마스터',zone: 54, bonus: 20, costG: 4000,  costS: 5,  rate: 60,  border: 'border-fuchsia-500 text-fuchsia-400' },
            { level: 9,  name: '청룡의 비늘대',  zone: 56, bonus: 25, costG: 6000,  costS: 6,  rate: 55,  border: 'border-rose-500 text-rose-400' },
            { level: 10, name: '주작의 화염대',  zone: 58, bonus: 30, costG: 9000,  costS: 7,  rate: 50,  border: 'border-amber-500 text-amber-400' },
