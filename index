        };

        function loadPlayerData() {
            const saved = localStorage.getItem('fishing_player_save_v3');
            if (saved) {
                try { player = Object.assign(player, JSON.parse(saved)); } catch(e) {}
            }
            FISH_DATABASE.forEach(f => {
                if (!player.book[f.id]) {
                    player.book[f.id] = { caught: 0, rewardClaimed: false };
                }
            });
            updateTopDashboard();
        }

        function savePlayerData() {
            localStorage.setItem('fishing_player_save_v3', JSON.stringify(player));
            updateTopDashboard();
        }

        function updateTopDashboard() {
            document.getElementById('displayNickname').innerText = player.nickname;
            document.getElementById('goldText').innerText = player.gold.toLocaleString();
            document.getElementById('stoneText').innerText = player.stones.toLocaleString();

            const badge = document.getElementById('rodBadgeContainer');
            if (player.equippedSpecialRod) {
                const spec = SPECIAL_RODS.find(s => s.id === player.equippedSpecialRod);
                badge.className = `px-2 py-0.5 rounded-lg border-2 text-[10px] font-black ${spec.border}`;
                document.getElementById('rodBadgeName').innerText = `${spec.icon} ${spec.name.slice(0, 5)}`;
            } else {
                const rod = ROD_TIERS[player.rodLevel];
                badge.className = `px-2 py-0.5 rounded-lg border-2 text-[10px] font-black ${rod.border}`;
                document.getElementById('rodBadgeName').innerText = `+${player.rodLevel} ${rod.name.slice(0, 5)}`;
            }

            const hasUnclaimed = Object.keys(player.book).some(id => player.book[id].caught > 0 && !player.book[id].rewardClaimed);
            document.getElementById('bookNewDot').classList.toggle('hidden', !hasUnclaimed);
        }

        // 6. 모바일 최적화 릴링 시스템 (난이도 1.5 vs 3 분기)
        let gameState = 'IDLE';
        let biteTimeout = null;
        let biteWindowTimeout = null;
        let currentHookedFish = null;

        let reelingLoop = null;
        let fishZonePos = 40;
        let fishZoneTarget = 40;
        let userTensionPos = 20;
        let isReeling = false;
        let captureScore = 45;

        function handleMainAction() {
            soundClick();
            if (gameState === 'IDLE') {
                startCasting();
            } else if (gameState === 'BITE') {
                startReelingGame();
            } else if (gameState === 'CASTED') {
                cancelFishing("너무 일찍 당겨 물고기가 도망쳤습니다!");
            }
        }

        function startCasting() {
            gameState = 'CASTED';
            document.getElementById('actionBtnText').innerText = '기다리는 중...';
            document.getElementById('castActionBtn').className = 'w-full py-3 bg-slate-800 text-slate-400 font-bold text-base rounded-xl border border-slate-700';
            document.getElementById('statusToast').innerText = '잔잔한 물결 속에서 입질을 기다리는 중...';

            soundSplash();
            const bobber = document.getElementById('bobber');
            bobber.className = 'w-7 h-14 relative bobber-float';

            // 낚일 물고기 사전 결정
            currentHookedFish = pickRandomFish();

            const waitTime = 2200 + Math.random() * 2500;
            biteTimeout = setTimeout(() => {
                triggerBite();
            }, waitTime);
        }

        function pickRandomFish() {
            const rod = ROD_TIERS[player.rodLevel];
            let rareRateBonus = rod.bonus;

            // 특수 낚싯대 보너스 반영
            if (player.equippedSpecialRod === 'spec_golden') rareRateBonus += 25;

            const isOverseas = Math.random() < 0.45;
            const pool = FISH_DATABASE.filter(f => isOverseas ? f.category === 'overseas' : f.category === 'domestic');
            const rand = Math.random() * 100;

            if (rand < 3 + rareRateBonus * 0.15) {
                return pool.filter(f => f.grade === '신화')[0] || pool[pool.length - 1];
            } else if (rand < 9 + rareRateBonus * 0.25) {
                const epics = pool.filter(f => f.grade === '전설');
                return epics[Math.floor(Math.random() * epics.length)] || pool[0];
            } else if (rand < 25 + rareRateBonus * 0.35) {
                const heroes = pool.filter(f => f.grade === '영웅');
                return heroes[Math.floor(Math.random() * heroes.length)] || pool[0];
            } else if (rand < 55) {
                const uncommons = pool.filter(f => f.grade === '희귀' || f.grade === '고급');
                return uncommons[Math.floor(Math.random() * uncommons.length)] || pool[0];
            } else {
                const commons = pool.filter(f => f.grade === '일반');
                return commons[Math.floor(Math.random() * commons.length)] || pool[0];
            }
        }

        function triggerBite() {
            gameState = 'BITE';
            soundHit();
            if (navigator.vibrate) navigator.vibrate([100, 50, 150]);

            const bobber = document.getElementById('bobber');
            bobber.className = 'w-7 h-14 relative bobber-bite';
            document.getElementById('hitBubble').classList.remove('hidden');

            document.getElementById('actionBtnText').innerText = '💥 지금 챔질하기!';
            document.getElementById('castActionBtn').className = 'w-full py-3 bg-red-600 text-white font-black text-base rounded-xl border-t border-red-300 animate-pulse';
            document.getElementById('statusToast').innerText = '강한 입질! 어서 챔질 버튼을 누르세요!';

            // 1.5초 이내에 챔질
            biteWindowTimeout = setTimeout(() => {
                if (gameState === 'BITE') {
                    cancelFishing("물고기가 미끼만 채가고 도망쳤습니다!");
                }
            }, 1500);
        }

        function cancelFishing(reason) {
            clearTimeout(biteTimeout);
            clearTimeout(biteWindowTimeout);
            soundFail();
            gameState = 'IDLE';
            document.getElementById('hitBubble').classList.add('hidden');
            const bobber = document.getElementById('bobber');
            bobber.className = 'w-7 h-14 relative bobber-float';
            
            document.getElementById('statusToast').innerText = reason;
            document.getElementById('actionBtnText').innerText = '찌 던지기';
            document.getElementById('castActionBtn').className = 'w-full py-3 bg-gradient-to-r from-sky-500 to-blue-600 text-white font-black text-base rounded-xl shadow-lg';
        }

        function startReelingGame() {
            clearTimeout(biteWindowTimeout);
            gameState = 'REELING';
            document.getElementById('hitBubble').classList.add('hidden');
            document.getElementById('reelingUI').classList.remove('hidden');

            const isHard = currentHookedFish.isHard;
            
            // 난이도 표시
            document.getElementById('fightFishTierBadge').innerText = `${currentHookedFish.grade} 어종`;
            document.getElementById('fightFishDifficulty').innerText = isHard ? '⭐ 난이도: 3.0 (긴장!)' : '⭐ 난이도: 1.5 (쉬움)';
            document.getElementById('fightFishDifficulty').className = isHard ? 'text-xs text-rose-400 font-bold ml-1.5' : 'text-xs text-emerald-400 font-bold ml-1.5';

            // 낚싯대 스펙 계산
            let baseZone = ROD_TIERS[player.rodLevel].zone;
            if (player.equippedSpecialRod) {
                const spec = SPECIAL_RODS.find(s => s.id === player.equippedSpecialRod);
                if (spec && spec.zoneBonus) baseZone += spec.zoneBonus;
            }

            // 난이도별 초록색 스위트스팟 존 크기
            const finalZone = isHard ? Math.max(34, baseZone - 6) : Math.max(48, baseZone);
            document.getElementById('fishSweetZone').style.height = `${finalZone}%`;

            fishZonePos = 35;
            userTensionPos = 20;
            captureScore = isHard ? 40 : 55; // 기본 물고기는 시작 점수도 넉넉하게

            const reelBtn = document.getElementById('reelBtn');
            reelBtn.onpointerdown = (e) => { e.preventDefault(); isReeling = true; };
            reelBtn.onpointerup = reelBtn.onpointercancel = (e) => { e.preventDefault(); isReeling = false; };

            reelingLoop = setInterval(updateReelingPhysics, 40);
        }

        function updateReelingPhysics() {
            const isHard = currentHookedFish.isHard;
            let baseZone = ROD_TIERS[player.rodLevel].zone;
            
            let drainReduction = 1.0;
            let speedDamp = 1.0;

            if (player.equippedSpecialRod) {
                const spec = SPECIAL_RODS.find(s => s.id === player.equippedSpecialRod);
                if (spec.zoneBonus) baseZone += spec.zoneBonus;
                if (spec.drainReduce) drainReduction = (1 - spec.drainReduce);
                if (spec.speedSlow) speedDamp = (1 - spec.speedSlow);
            }

            const zoneHeight = isHard ? Math.max(34, baseZone - 6) : Math.max(48, baseZone);

            // 물고기 움직임 (1.5성은 천천히, 3성은 약간 활발)
            const moveChance = (isHard ? 0.09 : 0.04) * speedDamp;
            if (Math.random() < moveChance) {
                fishZoneTarget = Math.max(5, Math.min(95 - zoneHeight, Math.random() * 85));
            }
            const lerpFactor = (isHard ? 0.10 : 0.05) * speedDamp;
            fishZonePos += (fishZoneTarget - fishZonePos) * lerpFactor;
            document.getElementById('fishSweetZone').style.bottom = `${fishZonePos}%`;

            // 유저 찌 인디케이터 반응 (누르고 있을 때/뗐을 때)
            if (isReeling) {
                userTensionPos = Math.min(92, userTensionPos + 3.8);
                if (Math.random() < 0.2) playTone(280, 'sine', 0.03, 0.04);
            } else {
                userTensionPos = Math.max(0, userTensionPos - 2.5);
            }
            document.getElementById('tensionIndicator').style.bottom = `${userTensionPos}%`;

            // 초록 영역 안 판정 (오차 범위 넉넉하게 부여)
            const inZone = (userTensionPos >= fishZonePos - 4) && (userTensionPos <= fishZonePos + zoneHeight + 2);

            if (inZone) {
                // 초록 영역 안: 게이지 상승 속도 증가
                captureScore += isHard ? 1.2 : 1.7;
                document.getElementById('fishSweetZone').classList.add('bg-emerald-400/80');
            } else {
                // 초록 영역 밖: 게이지 감소 대폭 완화
                const drainSpeed = (isHard ? 0.55 : 0.28) * drainReduction;
                captureScore -= drainSpeed;
                document.getElementById('fishSweetZone').classList.remove('bg-emerald-400/80');
            }

            captureScore = Math.max(0, Math.min(100, captureScore));
            document.getElementById('captureProgress').style.height = `${captureScore}%`;
            document.getElementById('capturePercentText').innerText = `${Math.floor(captureScore)}%`;

            if (captureScore >= 100) {
                finishFishing(true);
            } else if (captureScore <= 0) {
                finishFishing(false);
            }
        }

        function finishFishing(success) {
            clearInterval(reelingLoop);
            document.getElementById('reelingUI').classList.add('hidden');
            gameState = 'IDLE';

            document.getElementById('actionBtnText').innerText = '찌 던지기';
            document.getElementById('castActionBtn').className = 'w-full py-3 bg-gradient-to-r from-sky-500 to-blue-600 text-white font-black text-base rounded-xl shadow-lg';

            if (success) {
                soundSuccess();
                processFishCatch(currentHookedFish);
            } else {
                cancelFishing("물고기의 저항으로 줄이 끊어졌습니다!");
            }
        }

        // 7. 물고기 획득 처리 및 특수 낚싯대 해금 확인
        function processFishCatch(fish) {
            player.todayCount++;

            const length = (fish.minLen + Math.random() * (fish.maxLen - fish.minLen)).toFixed(1);
            const gainedGold = Math.floor(fish.baseGold * (1 + (length / fish.maxLen) * 0.6));
            const gainedExp = fish.exp;

            player.gold += gainedGold;
            player.book[fish.id].caught += 1;

            savePlayerData();
            checkSpecialRodsUnlock(); // 낚은 후 특수 낚싯대 달성 여부 실시간 확인

            document.getElementById('resultGradeBadge').innerText = fish.grade;
            document.getElementById('resultFishIcon').innerText = fish.icon;
            document.getElementById('resultFishName').innerText = fish.name;
            document.getElementById('resultFishLength').innerText = `${length} cm`;
            document.getElementById('resultGainGold').innerText = `+${gainedGold.toLocaleString()} G`;
            document.getElementById('resultGainExp').innerText = `+${gainedExp} EXP`;
            document.getElementById('resultModal').classList.remove('hidden');

            window.lastCatchData = { fish, length, gold: gainedGold, exp: gainedExp };
        }

        function copyKakaoResultText() {
            if (!window.lastCatchData) return;
            const d = window.lastCatchData;
            const rodName = player.equippedSpecialRod 
                ? SPECIAL_RODS.find(s => s.id === player.equippedSpecialRod).name 
                : `+${player.rodLevel} ${ROD_TIERS[player.rodLevel].name}`;

            const text = 
`@${player.nickname} 낚시 성공!

[${d.fish.name}] ${d.length}cm
등급: ${d.fish.grade} (${d.fish.category === 'domestic' ? '국내' : '해외'})
💰 획득 골드: ${d.gold}G
💰 보유 골드: ${player.gold.toLocaleString()}G
✨ 경험치: ${d.exp}EXP
🎣 사용 장비: ${rodName}`;

            navigator.clipboard.writeText(text).then(() => {
                alert("카카오톡 단톡방 공유 텍스트가 복사되었습니다!");
            });
        }

        // 8. 낚싯대 공방 & 특수 낚싯대 해금/장착
        let currentRodTab = 'normal';

        function switchRodTab(tab) {
            soundClick();
            currentRodTab = tab;
            document.getElementById('tabNormalRodBtn').className = tab === 'normal'
                ? 'py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400 transition'
                : 'py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 transition';
            document.getElementById('tabSpecialRodBtn').className = tab === 'special'
                ? 'py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400 transition'
                : 'py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 transition';

            document.getElementById('normalRodPanel').classList.toggle('hidden', tab !== 'normal');
            document.getElementById('specialRodPanel').classList.toggle('hidden', tab !== 'special');

            if (tab === 'special') renderSpecialRodList();
            else updateNormalRodUI();
        }

        function openUpgradeModal() {
            soundClick();
            switchRodTab('normal');
            document.getElementById('upgradeModal').classList.remove('hidden');
        }

        function updateNormalRodUI() {
            const curr = ROD_TIERS[player.rodLevel];
            const next = ROD_TIERS[player.rodLevel + 1];

            const preview = document.getElementById('rodPreviewCard');
            preview.className = `bg-slate-950 border-2 rounded-xl p-4 text-center transition-all ${curr.border}`;
            document.getElementById('rodPreviewName').innerText = `${curr.name} (+${curr.level})`;
            document.getElementById('rodPreviewStats').innerText = `스위트스팟: ${curr.zone}% | 희귀 어종 보너스: +${curr.bonus}%`;

            const btn = document.getElementById('upgradeActionBtn');
            if (next) {
                document.getElementById('nextRodName').innerText = `+${next.level} ${next.name}`;
                document.getElementById('upgradeChance').innerText = `${curr.rate}%`;
                document.getElementById('reqGold').innerText = curr.costG.toLocaleString();
                document.getElementById('reqStone').innerText = curr.costS;
                btn.disabled = false;
                btn.className = 'w-full py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-black rounded-xl active:scale-95 transition shadow-lg text-sm';
                btn.innerText = '강화 시도하기';
            } else {
                document.getElementById('nextRodName').innerText = '최대 15강 달성 (MAX)';
                document.getElementById('upgradeChance').innerText = '-';
                document.getElementById('reqGold').innerText = '-';
                document.getElementById('reqStone').innerText = '-';
                btn.disabled = true;
                btn.className = 'w-full py-3 bg-slate-800 text-slate-500 font-bold rounded-xl text-sm';
                btn.innerText = '최고 강화 등급입니다';
            }
        }

        function tryUpgradeRod() {
            const curr = ROD_TIERS[player.rodLevel];
            if (player.gold < curr.costG || player.stones < curr.costS) {
                alert("골드 또는 강화석이 부족합니다!\n도감 보상을 수령해보세요.");
                return;
            }

            player.gold -= curr.costG;
            player.stones -= curr.costS;

            if ((Math.random() * 100) <= curr.rate) {
                soundSuccess();
                player.rodLevel += 1;
                alert(`🎉 [강화 성공] +${player.rodLevel} [${ROD_TIERS[player.rodLevel].name}] 완성!`);
            } else {
                soundFail();
                alert("💥 [강화 실패] 등급은 유지되며 재료만 소모되었습니다.");
            }

            savePlayerData();
            updateNormalRodUI();
        }

        // 특수 낚싯대 해금 여부 판별 로직
        function isSpecialRodUnlocked(rod) {
            if (rod.customCheck) return rod.customCheck(player.book);
            return rod.targetFishIds.every(id => player.book[id] && player.book[id].caught > 0);
        }

        function checkSpecialRodsUnlock() {
            SPECIAL_RODS.forEach(rod => {
                if (isSpecialRodUnlocked(rod) && !localStorage.getItem(`unlocked_${rod.id}`)) {
                    localStorage.setItem(`unlocked_${rod.id}`, 'true');
                    alert(`🎊 [특수 낚싯대 해금!] 도감 조건을 만족하여 [${rod.name}]을(를) 획득했습니다! 공방에서 장착하세요.`);
                }
            });
        }

        function renderSpecialRodList() {
            const container = document.getElementById('specialRodList');
            container.innerHTML = '';

            // 기본 15강 낚싯대로 되돌리는 옵션
            const isDefaultEquipped = player.equippedSpecialRod === null;
            const defItem = document.createElement('div');
            defItem.className = `p-3 rounded-xl border flex items-center justify-between ${isDefaultEquipped ? 'border-sky-500 bg-sky-950/30' : 'border-slate-800 bg-slate-950/60'}`;
            defItem.innerHTML = `
                <div>
                    <div class="font-bold text-slate-200">일반 강화 낚싯대 (+${player.rodLevel})</div>
                    <div class="text-[10px] text-slate-400">내가 강화한 15단계 일반 로드를 장착합니다.</div>
                </div>
                <button onclick="equipSpecialRod(null)" class="px-2.5 py-1 rounded text-xs font-bold ${isDefaultEquipped ? 'bg-sky-500 text-white' : 'bg-slate-800 text-slate-300'}">
                    ${isDefaultEquipped ? '장착 중' : '장착하기'}
                </button>
            `;
            container.appendChild(defItem);

            // 특수 낚싯대 4종 렌더링
            SPECIAL_RODS.forEach(rod => {
                const unlocked = isSpecialRodUnlocked(rod);
                const isEquipped = player.equippedSpecialRod === rod.id;

                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border flex flex-col space-y-2 ${unlocked ? (isEquipped ? 'border-amber-400 bg-amber-950/20' : 'border-slate-700 bg-slate-950/80') : 'border-slate-900 bg-slate-950/30 opacity-60'}`;

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="text-2xl">${rod.icon}</span>
                            <div>
                                <h4 class="font-bold text-xs text-white">${rod.name}</h4>
                                <span class="text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-amber-300 font-semibold">${rod.targetDesc}</span>
                            </div>
                        </div>
                        <div>
                            ${
                                !unlocked 
                                ? `<span class="text-[10px] text-slate-500 font-bold bg-slate-900 px-2 py-1 rounded">🔒 미해금</span>`
                                : isEquipped
                                ? `<span class="text-[10px] text-emerald-400 font-black px-2 py-1 bg-emerald-950/50 rounded border border-emerald-500/40">장착 중</span>`
                                : `<button onclick="equipSpecialRod('${rod.id}')" class="px-2.5 py-1 bg-sky-500 text-white text-xs font-bold rounded shadow active:scale-95 transition">장착</button>`
                            }
                        </div>
                    </div>
                    <p class="text-[10px] text-slate-300">${rod.desc}</p>
                `;
                container.appendChild(card);
            });
        }

        function equipSpecialRod(rodId) {
            soundClick();
            player.equippedSpecialRod = rodId;
            savePlayerData();
            renderSpecialRodList();
        }

        // 9. 도감 렌더링
        let currentBookTab = 'domestic';

        function switchBookTab(tab) {
            soundClick();
            currentBookTab = tab;
            document.getElementById('tabDomesticBtn').className = tab === 'domestic' 
                ? 'py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400' 
                : 'py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700';
            document.getElementById('tabOverseasBtn').className = tab === 'overseas' 
                ? 'py-1.5 rounded-lg text-xs font-bold bg-sky-600 text-white border border-sky-400' 
                : 'py-1.5 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700';
            renderBookList();
        }

        function openBookModal() {
            soundClick();
            renderBookList();
            document.getElementById('bookModal').classList.remove('hidden');
        }

        function renderBookList() {
            const listEl = document.getElementById('bookList');
            listEl.innerHTML = '';

            const list = FISH_DATABASE.filter(f => f.category === currentBookTab);
            const caughtTotal = Object.values(player.book).filter(v => v.caught > 0).length;
            document.getElementById('bookCaughtCount').innerText = caughtTotal;

            list.forEach(fish => {
                const bookData = player.book[fish.id] || { caught: 0, rewardClaimed: false };
                const isCaught = bookData.caught > 0;

                const item = document.createElement('div');
                item.className = `p-2.5 rounded-xl border flex items-center justify-between transition ${
                    isCaught ? 'bg-slate-950/75 border-slate-800' : 'bg-slate-950/30 border-slate-900/60'
                }`;

                item.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="text-2xl w-8 text-center ${isCaught ? '' : 'fish-silhouette'}">
                            ${fish.icon}
                        </div>
                        <div>
                            <div class="flex items-center space-x-1.5">
                                <span class="font-bold text-xs ${isCaught ? 'text-white' : 'text-slate-500'}">
                                    ${isCaught ? fish.name : '??? (미지의 물고기)'}
                                </span>
                                <span class="text-[9px] px-1.5 py-0.5 rounded ${isCaught ? 'bg-slate-800 text-sky-400' : 'bg-slate-900 text-slate-600'} font-semibold">
                                    ${fish.grade}
                                </span>
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5">
                                ${isCaught ? `포획 횟수: <span class="text-slate-200 font-bold">${bookData.caught}마리</span>` : '아직 발견하지 못함 (실루엣)'}
                            </div>
                        </div>
                    </div>
                    <div>
                        ${
                            !isCaught
                            ? `<span class="text-[10px] text-slate-600 font-bold px-2 py-1 bg-slate-900 rounded">미발견</span>`
                            : bookData.rewardClaimed
                            ? `<span class="text-[10px] text-emerald-400 font-bold px-2 py-1 bg-emerald-950/40 rounded border border-emerald-500/30">수령 완료</span>`
                            : `<button onclick="claimBookReward('${fish.id}')" class="px-2.5 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 text-[11px] font-black rounded-lg shadow active:scale-95 transition">
                                🎁 보상 수령
                               </button>`
                        }
                    </div>
                `;
                listEl.appendChild(item);
            });
        }

        function claimBookReward(fishId) {
            const fish = FISH_DATABASE.find(f => f.id === fishId);
            if (!fish || player.book[fishId].rewardClaimed) return;

            soundSuccess();
            player.book[fishId].rewardClaimed = true;
            player.gold += fish.rewardGold;
            player.stones += fish.rewardStone;

            savePlayerData();
            alert(`🎁 [${fish.name}] 도감 보상 완료!\n💰 +${fish.rewardGold}G / 💎 강화석 +${fish.rewardStone}개`);
            renderBookList();
        }

        // 10. 닉네임 설정
        function openNicknameModal() {
            document.getElementById('nicknameInput').value = player.nickname;
            document.getElementById('nicknameModal').classList.remove('hidden');
        }

        function saveNickname() {
            soundClick();
            const val = document.getElementById('nicknameInput').value.trim();
            if (val) {
                player.nickname = val;
                savePlayerData();
            }
            closeModal('nicknameModal');
        }

        function closeModal(id) {
            soundClick();
            document.getElementById(id).classList.add('hidden');
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadPlayerData();
            updateMuteUI();
            if (!localStorage.getItem('fishing_player_save_v3')) {
                openNicknameModal();
            }
        });
    </script>
</body>
</html>
