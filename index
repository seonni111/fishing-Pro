        const FISH_DATABASE = [];

        function buildFishDb() {
            const grades = ['일반', '고급', '희귀', '영웅', '전설', '신화'];
            const icons = ['🐟', '🐠', '🐡', '🦈', '🐊', '✨'];

            DOMESTIC_FISH_NAMES.forEach((name, i) => {
                let g = 0;
                if (i >= 48) g = 5;
                else if (i >= 44) g = 4;
                else if (i >= 38) g = 3;
                else if (i >= 25) g = 2;
                else if (i >= 12) g = 1;

                FISH_DATABASE.push({
                    id: `dom_${i+1}`,
                    category: 'domestic',
                    name: name,
                    grade: grades[g],
                    icon: icons[g % icons.length],
                    isHard: g >= 2, // 희귀 이상부터 3성 난이도
                    minLen: 10 + i * 2,
                    maxLen: 20 + i * 3,
                    baseGold: (g + 1) * 35,
                    exp: (g + 1) * 12,
                    rewardGold: (g + 1) * 200,
                    rewardStone: Math.max(1, g * 2)
                });
            });

            OVERSEAS_FISH_NAMES.forEach((name, i) => {
                let g = 1;
                if (i >= 46) g = 5;
                else if (i >= 38) g = 4;
                else if (i >= 25) g = 3;
                else if (i >= 15) g = 2;

                FISH_DATABASE.push({
                    id: `ovs_${i+1}`,
                    category: 'overseas',
                    name: name,
                    grade: grades[g],
                    icon: icons[g % icons.length],
                    isHard: g >= 2,
                    minLen: 30 + i * 4,
                    maxLen: 60 + i * 6,
                    baseGold: (g + 1) * 50,
                    exp: (g + 1) * 20,
                    rewardGold: (g + 1) * 350,
                    rewardStone: Math.max(1, g * 3)
                });
            });
        }
        buildFishDb();

        // 5. 유저 저장소 관리
        let player = {
            nickname: '강태공',
            gold: 300,
            stones: 3,
            rodLevel: 0,
            equippedSpecialRod: null, // null 이면 일반 15강대 착용
            todayCount: 0,
